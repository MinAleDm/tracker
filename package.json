{
  "name": "tracker-monorepo",
  "private": true,
  "version": "1.1.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.13.1",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @tracker/api --filter @tracker/web dev",
    "build": "pnpm run db:generate && pnpm -r build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm run db:generate && pnpm -r typecheck",
    "test": "pnpm run db:generate && pnpm --filter @tracker/api test",
    "db:generate": "pnpm --filter @tracker/db prisma:generate",
    "db:migrate": "pnpm --filter @tracker/db prisma:migrate",
    "db:seed": "pnpm --filter @tracker/db prisma:seed",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.18",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.0",
      "postcss": "8.5.26",
      "sharp": "0.35.0"
    }
  }
}
